# Copy to .env with setup-workspace.bat or setup-workspace.sh.
# Keep one KEY=VALUE pair per line. Names must match [A-Za-z_][A-Za-z0-9_]*.
# AAWT_INTERNAL_ is reserved. Values may use A-Z a-z 0-9 . _ ~ : / ? @ + , - = only.
# Do not add real secrets to this tracked example.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
